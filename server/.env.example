# Copie ce fichier en .env et adapte les valeurs

# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg2://sigma:sigma_password@db:5432/sigma

# Sécurité JWT
SECRET_KEY=change-this-secret-key-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (front en dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Établissement par défaut créé au premier démarrage (seed)
SEED_ORG_NAME=Mon Établissement
SEED_ADMIN_EMAIL=admin@sigma.local
SEED_ADMIN_PASSWORD=Admin123!
